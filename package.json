{
  "name": "next-control-residencial",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.11.0 <23",
    "pnpm": ">=9.15.0 <10"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:cobertura": "turbo run test:cobertura",
    "frontera": "eslint packages/domain-core/src apps/api/src --max-warnings=0",
    "secretos": "./scripts/escanear-secretos.sh",
    "verificar": "pnpm lint && pnpm typecheck && pnpm test && pnpm secretos && pnpm portabilidad && pnpm contrato:tipado && pnpm contrato:desfasado",
    "prepare": "husky",
    "verificar:etapa": "./scripts/verificar-etapa.sh",
    "portabilidad": "node scripts/lib/portabilidad.mjs",
    "metricas": "node scripts/lib/metricas.mjs",
    "contrato": "pnpm --filter @ncr/api build && pnpm --filter @ncr/api openapi",
    "contrato:tipado": "node scripts/lib/contrato-tipado.mjs",
    "entorno": "node scripts/lib/verificar-entorno.mjs",
    "contrato:cliente": "pnpm --filter @ncr/contracts generar",
    "contrato:desfasado": "node scripts/lib/contrato-desfasado.mjs",
    "entorno:diff": "node scripts/lib/comparar-entorno.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "9.17.0",
    "husky": "9.1.7",
    "jose": "5.9.6",
    "lint-staged": "15.2.11",
    "otplib": "12.0.1",
    "playwright": "1.63.0",
    "prettier": "3.4.2",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.3.0",
      "express>path-to-regexp": "^0.1.13",
      "js-yaml": "^4.3.2",
      "lodash": "^4.17.24",
      "postcss": "^8.5.18",
      "vitest": "^3.2.6",
      "vite": "^6.4.3",
      "@vitest/coverage-v8": "^3.2.6"
    }
  }
}
