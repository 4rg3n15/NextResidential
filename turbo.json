{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@ncr/edge#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "test": { "dependsOn": ["^build"] },
    "test:cobertura": { "dependsOn": ["^build"], "outputs": ["coverage/**"] }
  }
}
