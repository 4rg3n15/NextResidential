{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@ncr/edge#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL_PRUEBAS", "NCR_CLAIMS_ARRANQUE"]
    },
    "test:cobertura": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["DATABASE_URL_PRUEBAS", "NCR_CLAIMS_ARRANQUE"]
    }
  }
}
