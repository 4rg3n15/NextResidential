{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@ncr/edge#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": { "dependsOn": ["^build"] },
    "@ncr/api#typecheck": { "dependsOn": ["^build"], "cache": false },
    "@ncr/domain-core#typecheck": { "dependsOn": ["^build"], "cache": false },
    "@ncr/providers#typecheck": { "dependsOn": ["^build"], "cache": false },
    "@ncr/edge#typecheck": { "dependsOn": ["^build"], "cache": false },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL_PRUEBAS", "NCR_BASE_EXIGIDA", "NCR_CLAIMS_ARRANQUE", "GO2RTC_BIN"]
    },
    "test:cobertura": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["DATABASE_URL_PRUEBAS", "NCR_BASE_EXIGIDA", "NCR_CLAIMS_ARRANQUE", "GO2RTC_BIN"]
    }
  }
}
