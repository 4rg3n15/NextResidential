# =============================================================================
# apps/api · NestJS · EJEMPLO — nunca con valores reales
#
# Este archivo se versiona. `.env` NO (ver .gitignore).
# El modulo de configuracion (ETAPA 02) valida estas variables con Zod al
# arranque: si falta una, la aplicacion NO ARRANCA (CLAUDE.md §2.7.1).
# =============================================================================

NODE_ENV=development
PORT=3000

# --- Supabase ----------------------------------------------------------------
# Esquema NUEVO de llaves. Los proyectos creados desde noviembre de 2025 ya no
# traen las llaves heredadas `anon` ni `service_role`, ni un secreto JWT
# compartido: la firma es asimetrica y se verifica contra JWKS.
#
# Panel > Settings > API Keys  (ahi viven TODAS las llaves, heredadas o no)
SUPABASE_URL=

# Publicable (sb_publishable_...). Reemplaza a `anon`. NO es un JWT.
# Resuelve al rol de PostgreSQL `anon`, asi que sigue sujeta a RLS.
SUPABASE_PUBLISHABLE_KEY=

# Secreta (sb_secret_...). Reemplaza a `service_role`. NO es un JWT y es
# revocable de forma individual, sin rotar nada mas.
# OMITE RLS: resuelve al rol `service_role`, que lleva BYPASSRLS. Solo
# servidor. Jamas en un cliente, jamas en NEXT_PUBLIC_*, jamas compilada en
# Flutter. Toda ruta que la use debe validar copropiedad_id en la capa de
# aplicacion (CLAUDE.md §2.7.6).
SUPABASE_SECRET_KEY=

# --- Verificacion de JWT (asimetrica) ----------------------------------------
# Ya NO hay secreto compartido que verificar. La API descarga las claves
# publicas del JWKS y valida la firma con ellas.
# Panel > Project Settings > JWT Keys
# La ruta es EXACTAMENTE esta. /auth/v1/jwks NO existe: devuelve 404 y la API
# se queda sin claves, rechazando todos los tokens. Comprobado contra la
# documentacion oficial de Supabase; ver docs/arquitectura/verificacion-jwt-asimetrica.md
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# El JWKS se cachea 10 min en el edge de Supabase. La cache local NO debe
# superar ese valor: si es mayor, una clave rotada seguiria aceptandose.
JWKS_CACHE_TTL_SEGUNDOS=600
# Refresco reactivo ante un `kid` desconocido, con cortafuegos para que un
# token con kid inventado no dispare una descarga por peticion.
JWKS_REFRESCO_MINIMO_SEGUNDOS=60

# --- Base de datos -----------------------------------------------------------
# Panel > Project Settings > Database > Connection string
# Directa: para migraciones. Pooler: para la aplicacion.
#
# IMPORTANTE (correccion 2026-09-06, migracion 0017): el usuario de estas dos
# cadenas debe ser `app_api`, NO `postgres`. `postgres` es el DUEÑO de las tablas
# y puede reconcederse cualquier privilegio que se le revoque, lo que anula la
# inmutabilidad de `eventos` (RN-03, CA-23, ADR-005). `app_api` no es dueño, no
# omite RLS y no tiene DDL.
#   directa : postgresql://app_api:<clave>@db.<ref>.supabase.co:5432/postgres
#   pooler  : postgresql://app_api.<ref>:<clave>@<region>.pooler.supabase.com:6543/postgres
#             (el pooler exige el project ref tras un punto en el usuario)
# La clave de `app_api` se asigna fuera del repositorio: guia CONEXION_SUPABASE.md §12.
DATABASE_URL=
DATABASE_POOLER_URL=

# Tamano del pool de la API. Por omision 20; subirlo sin subir el limite del
# proyecto Supabase agota las conexiones antes de que sirva de algo.
PG_POOL_MAX=20

# --- Colas -------------------------------------------------------------------
PGBOSS_SCHEMA=pgboss
# ETAPA 14 · si este proceso ejecuta los trabajos programados (latidos, aforos,
# barrido de plantillas). Con varias instancias puede quedar en `true` en todas:
# pg-boss toma el cerrojo en PostgreSQL y solo una ejecuta cada disparo. En
# `false` el proceso REGISTRA que no los va a ejecutar, y no calla.
PLANIFICADOR_HABILITADO=true

# --- Seguridad ---------------------------------------------------------------
# Lista blanca explicita, separada por comas. Nunca "*" ni origin:true.
CORS_ALLOWED_ORIGINS=http://localhost:3001

# D-90 · Estos tres nombres CAMBIARON en esta ronda, y no por gusto: el fichero
# declaraba RATE_LIMIT_TTL, RATE_LIMIT_LIMIT y MAX_PAYLOAD_BYTES, y el codigo
# nunca ha leido ninguno de los tres. Como el esquema tiene valores por
# omision, la aplicacion arrancaba igual: quien endurecia el limite de
# peticiones creia haberlo endurecido y seguia con 60 s y 120 peticiones.
# Si en su .env tiene los nombres viejos, renombrelos; no hacen nada.
THROTTLE_TTL_SEGUNDOS=60
THROTTLE_LIMITE=120

# Tamano maximo del cuerpo (§2.7.8). Acepta sufijos: 256kb, 1mb.
LIMITE_PAYLOAD=256kb

# A donde vuelve el usuario tras pedir el restablecimiento de su contrasena.
# OPCIONAL. Si la pone, tiene que ser una URL ABSOLUTA y su origen debe estar
# entre los de CORS_ALLOWED_ORIGINS; el arranque lo comprueba.
# Va comentada a proposito: una linea `VAR=` es una variable declarada vacia, y
# aunque desde D-91 el arranque la trata como ausente, dejarla comentada con su
# valor de referencia se lee mejor que un `=` solo.
# RECUPERACION_URL_REDIRECCION=http://localhost:3001/restablecer

# Bucket PRIVADO de evidencia (RN-21). OPCIONAL mientras el almacen sea el de
# memoria; en cuanto exista, la evidencia deja de perderse al reiniciar y el
# arranque comprueba que el bucket existe, que es privado y que un GET sin
# firmar se rechaza. La guia de conexion lo pide en su §7.1.
# EVIDENCIA_BUCKET=evidencias

# --- Boveda de credenciales de dispositivo ------------------------------------
# dispositivos.credencial_ref guarda `vault:...` o `env:...`, nunca la
# credencial. Aqui se configura como resolver esa referencia (RN-21, D-09b).
DEVICE_VAULT_PROVIDER=env
DEVICE_VAULT_URL=

# --- Cifrado de plantillas biometricas (decision D-10) ------------------------
# La llave NUNCA vive en PostgreSQL: si la llave esta en la base, quien lee la
# base lee la llave.
BIOMETRIC_KEY_REF=
BIOMETRIC_ALGORITHM=aes-256-gcm

# --- Observabilidad (ETAPA 14) -----------------------------------------------
# SENTRY_DSN es OPCIONAL: sin el, la API arranca igual y el reporte de errores
# queda en objeto nulo. Lo que NO se admite es un DSN presente y mal formado,
# porque eso es un despliegue que cree tener reporte y no lo tiene. El valor lo
# da el panel de Sentry y tiene la forma
#   https://<clave-publica>@o<org>.ingest.sentry.io/<id-de-proyecto>
# La clave publica del DSN no es un secreto (viaja en cada sobre), pero el DSN
# identifica el proyecto: no se versiona con valor.
SENTRY_DSN=
# Umbral minimo de severidad que se escribe: debug | info | aviso | error.
LOG_LEVEL=info
# Muestras de la ventana deslizante de latencias (RNF-11.3). Acota la memoria.
METRICAS_VENTANA=2048

# --- Ingesta de eventos de hardware (Alarm Server, RNF-03.11) ----------------
# Secreto compartido con el que el Alarm Server firma cada POST. Minimo 32
# caracteres. Sin el, la API no arranca (§2.7.1): un endpoint de ingesta sin
# firma aceptaria eventos de cualquiera. Se rota segun docs/guias.
INGESTA_FIRMA_SECRETO=
# Antiguedad maxima admitida de una firma, en segundos (anti repeticion).
INGESTA_VENTANA_SEGUNDOS=300

# --- Camaras que publican en el servidor de alarma (ETAPA 15) ----------------
# La camara NO firma: publica multipart sin prueba de autoria. Este extremo se
# acredita con un SECRETO LARGO POR EQUIPO mas el ORIGEN del aparato, que es
# mas debil que la firma HMAC de la ingesta. El hallazgo H-15-1 lo declara con
# su endurecimiento pendiente: la medida real es la VLAN de equipos.
#
#   copropiedad|dispositivo|secreto|ip[,ip]   y  ;  entre equipos
#
# El secreto necesita 32 caracteres como minimo. Generelo con:
#   openssl rand -hex 32
# VACIA por omision, y entonces el extremo NO acredita a nadie: un despliegue
# sin camaras declaradas rechaza todo en vez de aceptar todo.
ALARM_SERVER_EQUIPOS=

# --- Limites de peticiones de la ingesta (D-28, ETAPA 06) --------------------
# Tope por EQUIPO y por minuto. Holgado para una camara sana; corta en seco a
# una con el firmware colgado, que si no llenaria una tabla que no admite
# borrado.
THROTTLE_DISPOSITIVO_LIMITE=120
# Tope por IP en las rutas de ingesta, deliberadamente ALTO: todos los equipos
# de una copropiedad salen por el mismo enrutador, asi que el tope global de
# 120/min los sumaria a todos y dejaria fuera a las camaras sanas. La proteccion
# fina es la del dispositivo firmante; esta es solo una red contra inundaciones.
# Se descubrio midiendo: la prueba de carga se paro en 120 de 200 eventos con
# 200 dispositivos distintos y una sola IP de origen.
THROTTLE_INGESTA_IP_LIMITE=3000

# --- Biometria (ETAPA 08, Ley 1581 de 2012) ----------------------------------
# Llave de cifrado de las plantillas biometricas. Minimo 32 caracteres.
# Se cifra en la APLICACION y no con pgcrypto (D-10): si la llave viviera en la
# base, quien lea la base lee la llave y el cifrado no protege del volcado, que
# es la fuga que importa. Sin ella la API no arranca: una API que levanta sin
# llave y falla al guardar la primera plantilla habria hecho capturar el rostro
# de un visitante para nada.
# NUNCA en el repositorio, nunca en NEXT_PUBLIC_*, nunca compilada en Flutter.
BIOMETRIA_LLAVE=
# Lo UNICO que se persiste junto a la plantilla: una referencia, no la llave.
# Formato obligatorio `env:NOMBRE` o `vault:ruta` (migracion 0008).
BIOMETRIA_LLAVE_REF=env:BIOMETRIA_LLAVE
# P-03 · plazo de respuesta del titular al consentimiento, en horas.
# Supuesto vigente 24 h: pasado el plazo el consentimiento expira y la
# autorizacion sigue viva solo por placa (CU-02, flujo alterno).
BIOMETRIA_PLAZO_CONSENTIMIENTO_HORAS=24

# --- Proveedor de hardware (ETAPA 15-C) --------------------------------------
# QUE ADAPTADOR SE INYECTA. Es la unica decision que separa correr contra el
# simulado de correr contra los equipos, y vive aqui y no dentro de un modulo:
# cambiarla no toca una linea de dominio, aplicacion ni interfaz, y esa es la
# verificacion de OE-03 y de ADR-03.
#
#   simulado   (por omision) — todo el sistema funciona sin un solo aparato.
#   hikvision              — habla con los equipos dados de alta en la consola.
#
# El simulado es el de por omision y lo seguira siendo: un despliegue que se
# pusiera en modo hardware por descuido informaria de aperturas que nunca
# ocurrieron. Un valor que no sea ninguno de los dos IMPIDE EL ARRANQUE.
PROVEEDOR_DE_EQUIPOS=simulado
# Semilla del simulado. La adversidad que genera —latencia, fallos, duplicados—
# tiene que ser reproducible: una prueba que falla con una semilla y pasa con
# otra no es una prueba.
PROVEEDOR_SEMILLA=20260908

# --- Cargador de contexto del motor (ETAPA 15-D, D-25) -----------------------
# Quien reune lo que el motor de reglas necesita para decidir una lectura.
#
#   postgres     (por omision) — lee autorizaciones, padron y lista negra de
#                 la base. Es el unico con el que una placa autorizada desde la
#                 consola se PERMITE.
#   conservador  — no lee nada: el motor deniega toda lectura por FALLO_TECNICO.
#                 Correcto sin origen de datos; es el de la suite de pruebas.
#
# El arranque registra en la bitacora cual quedo activo. Un valor que no sea
# ninguno de los dos IMPIDE EL ARRANQUE.
CARGADOR_DE_CONTEXTO=postgres

# --- Historico de eventos (ETAPA 15-E) ---------------------------------------
# Donde vive `eventos`, la tabla append-only que sostiene RN-03 y CA-23.
#
#   postgres   (por omision) — en la base, con los claims de servicio de cada
#                copropiedad por llamada. Es el unico con el que un acceso
#                sobrevive a un reinicio y con el que la hoja de resultados en
#                sitio se puede cotejar contra /eventos.
#   memoria    — el doble de la ETAPA 06: sirve para ensayar sin base y es el
#                de la suite. Un despliegue en memoria NO tiene trazabilidad;
#                el arranque lo avisa.
PERSISTENCIA_DE_EVENTOS=postgres
# El mismo interruptor gobierna desde la 15-E (D-139) lo que acompana al
# historico: ALERTAS, ORDENES MANUALES de porteria/guardia (RN-08) y la
# AUDITORIA DE SEGURIDAD (accesos cruzados, restablecimientos, respuesta del
# titular). Con `memoria` todo eso se pierde al reiniciar y el arranque lo avisa.

# --- Biometria en la base (ETAPA 15-E, A3) -----------------------------------
# Donde viven consentimientos, plantillas (vector cifrado) y sincronizaciones.
#   postgres   (por omision) — tablas 0008/0022 con sus cerrojos: sin
#                consentimiento vigente la base rechaza la sincronizacion.
#   memoria    — el doble de la suite. Sin base no hay cerrojo que demostrar.
PERSISTENCIA_DE_BIOMETRIA=postgres
# Origen PUBLICO con el que se arma el enlace que recibe el TITULAR para
# responder su consentimiento (RN-10): http://<IP-del-Mac>:3000 en sitio.
# Tiene que ser alcanzable desde el telefono del visitante; `localhost` no lo
# es. Vacio = la API devuelve solo el token y la ruta, y la consola lo dice.
API_URL_PUBLICA=

# --- Vista en vivo (ETAPA 15-E, A5) ------------------------------------------
# Direccion INTERNA del puente de video go2rtc (RTSP -> WebRTC), tal como la
# alcanza la API: http://127.0.0.1:1984 si corre en la misma maquina. Vacio =
# la vista en vivo responde 503 con motivo y el resto de la consola sigue.
# La API registra en go2rtc el flujo RTSP de cada equipo (con la credencial
# que guarda cifrada) y negocia WebRTC EN NOMBRE del navegador tras validar
# sesion, rol y copropiedad. El navegador nunca ve esta URL ni la RTSP.
# Configuracion minima de go2rtc (go2rtc.yaml):
#   api:
#     listen: "127.0.0.1:1984"    # solo bucle local: la API es su unico cliente
#   webrtc:
#     listen: ":8555"             # UDP/TCP del medio hacia el navegador
#     candidates: [ "<IP-del-Mac>:8555" ]
GO2RTC_URL=

# --- Equipos (ETAPA 15-B, A.1) -----------------------------------------------
# Llave de cifrado del SECRETO de cada equipo (camara, terminal, videoportero).
# Minimo 32 caracteres. Es DISTINTA de BIOMETRIA_LLAVE a proposito: se comparte
# el codigo de cifrado, no el material de clave, para que comprometer una no
# entregue la otra.
# Al dar de alta un equipo desde la consola, su clave se guarda cifrada con
# esta llave derivada POR COPROPIEDAD (HKDF). La API nunca la devuelve.
# NUNCA en el repositorio, nunca en NEXT_PUBLIC_*, nunca compilada en Flutter.
EQUIPOS_LLAVE=
# Lo UNICO que se persiste junto al sobre: una referencia, no la llave.
# Formato obligatorio `env:NOMBRE` o `vault:ruta` (migracion 0032).
EQUIPOS_LLAVE_REF=env:EQUIPOS_LLAVE

# ─────────────────────────────────────────────────────────────────────────────
# SEGUNDO FACTOR · interruptor TEMPORAL (desviación declarada de RN-20/CA-25)
#
# Sin esta línea, o con `true`, rige el contrato: un rol administrativo no entra
# sin `aal2`. Con `false`, el guard acepta `aal1` para esos roles y NADA MÁS
# cambia: siguen exigiéndose contraseña, firma del token, rol y copropiedad.
#
# ─────────────────────────────────────────────────────────────────────────────
# BARRERA VEHICULAR · adaptador por entorno, COMPATIBILIDAD DECLARADA (15-E)
#
# Desde la ETAPA 15-E la apertura y el bloqueo de CUALQUIER dispositivo pasan
# por el proveedor de equipos (PROVEEDOR_DE_EQUIPOS), resueltos contra el
# registro de la consola y decididos por capacidades. Estas variables quedan
# como compatibilidad: son el unico control VERIFICADO contra el equipo
# (15/09/2026) y quien lo valido lo hizo con ellas. Si BARRERA_DISPOSITIVO_ID
# nombra un equipo, las ordenes de ESE dispositivo van por este control; el
# resto, por el proveedor. El arranque enuncia la regla completa y cada orden
# anota que camino la atendio: son dos caminos, ninguno silencioso. Sin estas
# variables no pasa nada: todo va por el proveedor.
#
# A MEDIAS NO: si se define alguna y faltan otras, el arranque FALLA y dice
# cuales faltan. Es deliberado. "Aqui no hay equipo" y "alguien se equivoco al
# escribir el nombre de una variable" no pueden acabar en el mismo sitio: el
# segundo dejaria una consola diciendo "abriendo" sin que nada se mueva.
#
# La credencial NO va en el repositorio (RN-21, §2.7.1). El escaneo de secretos
# corre en el gancho de pre-commit.
BARRERA_HOST=
BARRERA_PUERTO=80
BARRERA_USUARIO=
BARRERA_CLAVE=
# Milisegundos antes de dar el equipo por mudo. Por omision 3000.
BARRERA_TIEMPO_LIMITE_MS=3000
# Que dispositivo registrado atiende el equipo real. El resto siguen simulados:
# la eleccion es POR DISPOSITIVO y no por entorno, porque un conjunto puede
# tener una barrera conectada y tres puertas que no lo estan.
BARRERA_DISPOSITIVO_ID=
#
# El accionador activo se DICE al arrancar (ETAPA 15-D): "SIMULADO", "barrera
# REAL declarada pero SIN dispositivo asignado" o "barrera REAL por entorno".
#
# ─────────────────────────────────────────────────────────────────────────────
# GUION DE PUESTA EN MARCHA EN SITIO · scripts/puesta-en-marcha-equipos.mjs
#
# No las lee la API: las lee el guion, con `node --env-file=apps/api/.env`.
# Una familia se prueba si su *_HOST esta declarado. `*_CANAL` es el carril de
# la barrera, la puerta de la terminal o el canal de audio del videoportero
# (por omision 1). Sin ningun equipo delante, `--simulado` ensaya el guion.
#
# Una variable por linea, a proposito: el control `entorno-declarado` lee el
# ejemplo linea a linea y cada nombre de este bloque esta exento ahi CON su
# lector declarado. Un nombre que no figure en esa lista rompe la verificacion.
#
# BARRERA_CANAL=1
# TERMINAL_HOST=
# TERMINAL_PUERTO=80
# TERMINAL_USUARIO=
# TERMINAL_CLAVE=
# TERMINAL_CANAL=1
# VIDEOPORTERO_HOST=
# VIDEOPORTERO_PUERTO=80
# VIDEOPORTERO_USUARIO=
# VIDEOPORTERO_CLAVE=
# VIDEOPORTERO_CANAL=1
