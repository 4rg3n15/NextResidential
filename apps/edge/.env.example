# =============================================================================
# apps/edge · Edge Gateway (Node.js + SQLite) · EJEMPLO
#
# El Edge usa una IDENTIDAD DE SERVICIO propia por equipo (decision D-16), no
# una credencial compartida: asi cada evento queda atribuido (KPI-05) y la
# rotacion afecta a un solo equipo.
# =============================================================================

EDGE_GATEWAY_ID=
EDGE_SERVICE_USER_ID=
EDGE_CREDENTIAL_REF=vault:copropiedad/edge-01

NEXT_CONTROL_API_URL=
SQLITE_PATH=/var/lib/next-control/edge.sqlite

# --- Supabase ----------------------------------------------------------------
# El Edge ingiere eventos con la llave SECRETA, que OMITE RLS (rol
# `service_role`, BYPASSRLS). Por eso valida copropiedad_id en la capa de
# aplicacion, contra el contexto de su identidad de servicio.
# Se recomienda una llave secreta PROPIA por Edge: son varias y revocables de
# forma individual, asi que comprometer un equipo no obliga a rotar el resto.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Verificacion asimetrica, para el caso en que el Edge deba validar por si
# mismo un token de operador durante un corte de WAN.
# La ruta es EXACTAMENTE esta; /auth/v1/jwks devuelve 404.
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# El Edge opera hasta 24 h sin conexion (KPI-30): conserva el ultimo JWKS en
# disco para poder seguir verificando firmas durante el corte.
JWKS_CACHE_TTL_SEGUNDOS=600
JWKS_CACHE_PERSISTENTE=/var/lib/next-control/jwks.json

# Politica de contingencia cuando la regla no esta en cache (CU-04 3a).
# El valor por defecto del esquema es `denegar`; esta variable solo permite
# leerlo, no cambiarlo: la fuente de verdad es copropiedades.politica_contingencia_edge.
CONTINGENCIA_SIN_REGLA=denegar

# Backoff exponencial con jitter, para no chocar con el rate limiting de la API.
RECONCILIACION_INTENTOS=5
RECONCILIACION_BACKOFF_MS=1000
