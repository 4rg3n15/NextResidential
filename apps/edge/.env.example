# =============================================================================
# apps/edge · Edge Gateway (Node.js + SQLite) · EJEMPLO
#
# Este fichero se VERSIONA con nombres y descripciones, NUNCA con valores
# (§2.7.1). El `.env` real vive en el equipo y no entra al repositorio.
#
# Si falta cualquiera de las obligatorias, el gateway NO ARRANCA. En la API eso
# es un despliegue que no sube; aquí es una puerta que no se abre, y eso es lo
# correcto: un gateway a medias decide con reglas incompletas durante un corte y
# nadie se entera hasta que alguien no puede entrar — o hasta que entra quien no
# debía.
# =============================================================================

# --- Identidad del EQUIPO (obligatorias) -------------------------------------
# Una identidad de servicio POR GATEWAY (decisión D-16), no una compartida: así
# cada evento queda atribuido (KPI-05) y la rotación afecta a un solo equipo.
EDGE_GATEWAY_ID=
EDGE_SERVICE_USER_ID=

# La copropiedad que este equipo atiende. Es su frontera (RN-15): el gateway no
# decide ni reconcilia nada de otra.
EDGE_COPROPIEDAD_ID=

# --- Nube (obligatorias) -----------------------------------------------------
NEXT_CONTROL_API_URL=

# 15-Q · La CREDENCIAL de este gateway: la devuelve UNA sola vez la API al dar
# de alta el Edge (POST /copropiedades/<id>/edge-gateways, superadministrador)
# o al rotarla (POST …/edge-gateways/<edgeId>/credencial). Firma cada descarga
# de reglas y cada reconciliación (HMAC con método, ruta y marca temporal). Es
# POR EQUIPO y derivada: comprometer un gateway no obliga a rotar los demás.
# Alta en docs/guias/DESPLIEGUE_EDGE.md §2.1, rotación en §4.1. Mínimo 32 caracteres.
EDGE_INGESTA_SECRETO=

# --- Almacenamiento local ----------------------------------------------------
# Dónde vive la bandeja de salida y la caché de reglas. Tiene que estar en disco
# PERSISTENTE: en un `tmpfs` se perderían los accesos de un corte al reiniciar,
# y RN-02 dice que ningún acceso existe sin evento.
SQLITE_PATH=/var/lib/next-control/edge.sqlite

# --- Política de contingencia (CU-04, excepción 3a) --------------------------
# Qué hacer cuando la regla no está en caché. `denegar` (por omisión, §2.1.4) o
# `escalar`.
#
# OJO: `escalar` TAMPOCO ABRE la puerta. Niega automáticamente y entrega el caso
# al portero, que es una persona decidiendo. La diferencia con `denegar` es a
# quién le toca el siguiente paso, no si se abre.
CONTINGENCIA_SIN_REGLA=denegar

# --- Obsolescencia de la caché (KPI-31) --------------------------------------
# Minutos a partir de los cuales lo decidido se marca como «decidido con caché
# que pudo haber envejecido». NO impide decidir —eso incumpliría KPI-30— pero
# deja el evento marcado para la auditoría.
# Se mide desde que la NUBE generó la instantánea, no desde que llegó al equipo.
CACHE_OBSOLETA_MINUTOS=1440

# --- Detección de enlace -----------------------------------------------------
SONDA_WAN_SEGUNDOS=15
# Histéresis: sondas consecutivas para conmutar de modo. Caer cuesta caro —se
# deja de intentar la nube— así que se exige más evidencia que para volver.
SONDAS_PARA_CAER=3
SONDAS_PARA_VOLVER=2

# --- Reconciliación ----------------------------------------------------------
RECONCILIACION_LOTE=50
RECONCILIACION_INTENTOS=8
# Base del retroceso exponencial, con jitter que RESTA (§2.7.5): así el tope
# configurado sigue siendo un tope y varios gateways reconectando a la vez se
# dispersan sin que ninguno espere de más.
RECONCILIACION_BACKOFF_MS=1000

# =============================================================================
# EN SITIO · 15-Q (P-27 = B: el Edge es CONTINGENCIA)
#
# La nube sigue hablando con los equipos. El Edge los escucha EN PARALELO y sólo
# decide —y acciona— cuando la nube no puede (sin WAN, o la API no está lista).
# Detalle y procedimiento de corte real en docs/guias/DESPLIEGUE_EDGE.md §9.
# =============================================================================

# --- Equipos (obligatoria) ---------------------------------------------------
# JSON en UNA línea y ENTRE COMILLAS SIMPLES ('[...]'): así ni un `#` ni una
# comilla doble de una clave rompen la línea. La lista de equipos que el Edge
# escucha y acciona (DESPLIEGUE_EDGE.md §2.2). Lleva
# IPs y claves de los equipos: SÓLO en el `.env` del gateway (RN-21, KPI-11),
# nunca en el repositorio ni en un ticket. Forma de cada elemento (los <…> son
# marcadores, no valores):
#   {"dispositivoId":"<uuid del equipo en Next Control>",
#    "tipo":"camara_lpr|terminal_facial|intercom",
#    "host":"<ip del equipo>","puerto":80,"protocolo":"http",
#    "usuario":"<usuario de servicio>","clave":"<clave>",
#    "canalBarrera":1,"numeroDePuerta":1,
#    "secretoAlarmServer":"<32+ caracteres, sólo cámaras>"}
# `secretoAlarmServer` es obligatorio en una cámara: es lo que ella pone en la
# URL de su Alarm Server hacia el Edge (http://<escucha>/alarm-server/<secreto>),
# porque la cámara no sabe firmar ([CONTRADICCIÓN] C-50). El Edge exige además
# que la publicación venga del `host` de ESA cámara.
EDGE_EQUIPOS=

# --- Escucha local (Q5) ------------------------------------------------------
# La IP de UNA interfaz del gateway (la de la VLAN de equipos). 0.0.0.0 y ::
# se rechazan al arrancar: escuchar en todas no es configurar una.
EDGE_ESCUCHA_HOST=
EDGE_ESCUCHA_PUERTO=8080

# Secreto de las entradas locales firmadas (POST /hechos, GET /estado): HMAC
# con marca temporal y nonce de un solo uso. Mínimo 32 caracteres. Distinto de
# EDGE_INGESTA_SECRETO: el primero es hacia la nube, éste es dentro del sitio.
EDGE_LOCAL_SECRETO=

# Peticiones por minuto e IP a las entradas locales; pasado el límite, 429 con
# Retry-After.
EDGE_LIMITE_POR_MINUTO=300

# --- Reglas y nube -----------------------------------------------------------
# Cada cuántos segundos se pide la instantánea de reglas (además de al
# recuperar el WAN). La API contesta «sin cambios» si la versión no se movió.
REGLAS_DESCARGA_SEGUNDOS=300

# Plazo de la pregunta «¿la nube puede decidir?» que se hace por cada acceso
# mientras el Edge no ha confirmado la caída. Pasado el plazo, decide el Edge.
SONDA_POR_EVENTO_MS=1500

# Cada cuántos segundos se reintenta suscribirse a un equipo cuya escucha se
# cortó (terminal o videoportero reiniciados).
ESCUCHAS_REARME_SEGUNDOS=30

# --- 15-Q2 · El Edge como PUENTE entre la nube y los equipos (ADR-035) --------
# `activo`: el Edge abre un WebSocket SALIENTE hacia la API (wss://<api>/edge/tunel)
# y por él recibe las órdenes de la consola para los equipos del conjunto. La
# API, en la nube, no tiene ruta hacia la red del conjunto. `inactivo` (o vacío):
# el Edge de la 15-Q, sin túnel. Además, en la consola el superadministrador
# marca este Edge como «puente» de su copropiedad.
EDGE_TUNEL=

# Cuánto espera el Edge la decisión de la nube por cada acceso antes de decidir
# con su caché (B2). Entre 200 y 10000 ms; vacío = 2500.
EDGE_PLAZO_NUBE_MS=

# OBLIGATORIA con EDGE_TUNEL=activo. La llave AES-256-GCM con que el Edge cifra
# las credenciales de los equipos en su SQLite: 32 bytes en base64
# (`openssl rand -base64 32`). NUNCA en la misma carpeta que el SQLite ni en el
# repositorio: en el almacén de secretos del sistema o en el .env de la máquina.
# Perderla = volver a migrar las credenciales desde la consola.
EDGE_EQUIPOS_LLAVE=

# La API del go2rtc que corre JUNTO al Edge (D4): negocia el video de los
# equipos con su RTSP, que lleva la credencial y nunca sale del conjunto.
# Vacío = http://127.0.0.1:1984. Sólo direcciones de esta misma máquina.
EDGE_GO2RTC_URL=

# =============================================================================
# CÓMO HABLA EL EDGE CON LOS EQUIPOS · DT-15R-09 (corrección de la 15-R)
#
# Los MISMOS nombres, valores por omisión y límites que en apps/api/.env.example.
# Con puente es el Edge quien da de alta los rostros, abre las puertas y sirve
# el video, y lo hace con ESTOS valores, no con los de la API. Póngalos IGUALES
# en los dos `.env`: la ficha de la consola y «Probar conexión» siguen usando
# los de la API. Vacías = el valor de abajo.
# =============================================================================

# Desvío del reloj de un equipo (s, 1 a 3600) a partir del cual el Edge NO da de
# alta a nadie con vigencia en él: lee la hora del equipo antes de escribir y,
# si se pasa, no escribe ni la persona y dice cuánto va desviado. Con este mismo
# umbral juzga `pnpm sitio:edge` la hora de cada equipo.
EQUIPOS_DESVIO_DE_RELOJ_S=30
# Milisegundos que el Edge espera a un equipo en cada petición (500 a 30000).
# Con puente, la nube espera 4 s una apertura (KPI-32) y 30 s un alta, y esto no
# los alarga: una barrera que conteste después de 4 s abre cuando la nube ya la
# dio por no aceptada (DT-15R-C03).
EQUIPOS_TIEMPO_LIMITE_MS=5000
# Zona IANA del reloj de los equipos: la vigencia del visitante se escribe en
# hora local, sin desfase. Mal escrita, el Edge no arranca.
EQUIPOS_ZONA_HORARIA=America/Bogota
# Plantilla horaria de la puerta en el alta de persona. "1" es la de la
# terminal; otros modelos usan "65535" para 7x24.
TERMINAL_PLAN_DE_HORARIO=1
# Peso (KB) y lado mayor (px) máximos de la foto que se sube a una terminal.
EQUIPOS_FOTO_KB_MAXIMOS=200
EQUIPOS_FOTO_LADO_MAXIMO=1024
# Puerto RTSP de los equipos (554 de fábrica): el go2rtc junto al Edge pide el
# video ahí.
VIDEO_PUERTO_RTSP=554
