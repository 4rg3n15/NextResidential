# =============================================================================
# apps/edge · Edge Gateway (Node.js + SQLite) · EJEMPLO
#
# El Edge usa una IDENTIDAD DE SERVICIO propia por equipo (decision D-16), no
# una credencial compartida: asi cada evento queda atribuido (KPI-05) y la
# rotacion afecta a un solo equipo.
# =============================================================================

EDGE_GATEWAY_ID=
EDGE_SERVICE_USER_ID=
EDGE_CREDENTIAL_REF=vault:copropiedad/edge-01

NEXT_CONTROL_API_URL=
SQLITE_PATH=/var/lib/next-control/edge.sqlite

# Politica de contingencia cuando la regla no esta en cache (CU-04 3a).
# El valor por defecto del esquema es `denegar`; esta variable solo permite
# leerlo, no cambiarlo: la fuente de verdad es copropiedades.politica_contingencia_edge.
CONTINGENCIA_SIN_REGLA=denegar

# Backoff exponencial con jitter, para no chocar con el rate limiting de la API.
RECONCILIACION_INTENTOS=5
RECONCILIACION_BACKOFF_MS=1000
