<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ETAPA 15-I (hito 3): la foto del visitante para la terminal facial. -->
	<key>NSCameraUsageDescription</key>
	<string>La cámara toma la foto del rostro de su visitante para la terminal facial del conjunto. El visitante decide si acepta.</string>
	<!-- image_picker exige declararla aunque la app sólo abre la cámara. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>La app no lee su fototeca: sólo usa la foto que toma con la cámara.</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Ncr Residente</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ncr_residente</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	H-SITIO-11 (15-K) · Privacidad de red local (iOS 14+). La app habla con la API
	por la IP privada del Mac en sitio, y en un iPhone físico iOS exige esta
	clave para pedir el permiso de red local: sin ella la conexión se corta y la
	app sólo decía «No hay conexión con el servidor» mientras Safari —que es de
	Apple y no pasa por este permiso— abría la misma API. Va FUERA del bloque de
	depuración: un despliegue del conjunto también puede servir la API en la
	red local, y la clave sólo describe el permiso; no concede nada por sí sola.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>La app se conecta al servidor de Next Control de su conjunto, que está en la red local.</string>
	<!--
	A6 · Excepción de App Transport Security SOLO en depuración.
	Xcode preprocesa este fichero con el preprocesador de C (INFOPLIST_PREPROCESS
	en ios/Flutter/Debug.xcconfig y Release.xcconfig). NCR_DEPURACION sólo se
	define en Debug.xcconfig, así que en Release y Profile el bloque de abajo se
	elimina y la app compilada NO lleva NSAppTransportSecurity. Las directivas
	van envueltas en comentarios XML para que el fichero crudo siga siendo un
	plist válido para cualquier herramienta que lo lea sin preprocesar.
	NSAllowsLocalNetworking cubre la API de desarrollo por IP privada; nunca
	NSAllowsArbitraryLoads.
	-->
	<!--
#if NCR_DEPURACION
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!--
#endif
	-->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
