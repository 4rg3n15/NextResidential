<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ETAPA 15-I (hito 3): la foto del visitante para la terminal facial. -->
	<key>NSCameraUsageDescription</key>
	<string>La cámara toma la foto del rostro de su visitante, con su autorización, para la terminal facial del conjunto.</string>
	<!--
	  Corrección de la 15-L: «Elegir de la galería». En iOS 14 o posterior (la
	  app exige 15) la galería es PHPicker, que corre fuera de la app y NO pide
	  este permiso, tampoco con el acceso limitado. La clave se declara porque
	  image_picker la exige; el texto dice la verdad por si el sistema la enseña.
	-->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Cuando elige en su galería la foto de su visitante, la app usa sólo esa foto, reducida, para la terminal facial del conjunto. No lee ni guarda el resto de sus fotos.</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Ncr Residente</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ncr_residente</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	H-SITIO-11 (15-K) · Privacidad de red local (iOS 14+). La app habla con la API
	por la IP privada del Mac en sitio, y en un iPhone físico iOS exige esta
	clave para pedir el permiso de red local: sin ella la conexión se corta y la
	app sólo decía «No hay conexión con el servidor» mientras Safari —que es de
	Apple y no pasa por este permiso— abría la misma API. Va en TODAS las
	configuraciones: la clave sólo describe el permiso; no concede nada por sí
	sola.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>La app se conecta al servidor de Next Control de su conjunto, que está en la red local.</string>
	<!--
	Corrección de la 15-L · App Transport Security, IGUAL en Debug, Release y
	Profile. La app se usa en sitio compilada en Release y abierta desde el
	ícono, sin el Mac conectado; la excepción de ATS tiene que ir en el binario
	que se instala. NSAllowsLocalNetworking relaja ATS sólo para lo local (los
	nombres .local y los que no tienen dominio); nunca NSAllowsArbitraryLoads.
	No es lo que hace falta para el transporte de la app: Dio usa dart:io, que
	abre sockets POSIX y NO pasa por ATS (Bloque 0.5); lo que sí lo alcanza es
	el permiso de red local de arriba. Va para cualquier componente que use el
	sistema de URL de Apple (un WebView, un plugin nativo). Lo comprueba
	scripts/lib/info-plist-ios.mjs en las tres configuraciones.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
