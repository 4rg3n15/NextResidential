# =============================================================================
# apps/web · Next.js · EJEMPLO — nunca con valores reales
#
# ADVERTENCIA: TODO lo que empieza por NEXT_PUBLIC_ es PUBLICO por definicion.
# Se compila en el paquete que se envia al navegador y cualquiera puede leerlo.
# Nunca pongas ahi la service_role key ni ningun secreto.
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# anon: publica por diseno y sujeta a RLS. Es la unica llave de Supabase que
# puede estar aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Puente de video (ETAPA 10): RTSP -> go2rtc -> WebRTC
NEXT_PUBLIC_GO2RTC_URL=

# Solo servidor (Route Handlers / Server Actions). Sin prefijo NEXT_PUBLIC_.
SESSION_COOKIE_SECRET=
